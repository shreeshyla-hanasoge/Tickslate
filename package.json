{
  "name": "tickslate-dev",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:site": "vite --config vite.site.config.js",
    "build:lib": "vite build --config vite.lib.config.js",
    "build:dev": "vite build --config vite.dev.config.js",
    "build:umd": "vite build --config vite.umd.config.js",
    "build:cdn": "vite build --config vite.cdn.config.js",
    "build:site": "node scripts/md.mjs --check && vite build --config vite.site.config.js",
    "build:ld": "node scripts/md.mjs --check && vite build --config vite.ld.config.js",
    "pack:site": "node scripts/pack-site.mjs",
    "preview:site": "vite preview --config vite.site.config.js",
    "pack:lib": "node scripts/pack-lib.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "lint": "eslint src",
    "size": "node scripts/check-size.mjs",
    "check:types": "node scripts/check-types.mjs",
    "check:attribution": "node scripts/check-attribution.mjs",
    "test:types": "npm run check:types",
    "test": "node --test test/*.test.mjs examples/custom-widget/*.test.mjs",
    "test:browser": "playwright test",
    "test:consumers": "node scripts/test-consumers.mjs",
    "test:visual": "playwright test test/browser/visual.spec.mjs --project=chromium",
    "test:visual:update": "docker run --rm --ipc=host -e UID_GID=\"$(id -u):$(id -g)\" -v \"$PWD\":/work -v tickslate-visual-node-modules:/work/node_modules -w /work mcr.microsoft.com/playwright:v1.64.0-noble sh -c \"npm ci && npx playwright test test/browser/visual.spec.mjs --project=chromium --update-snapshots; status=\\$?; chown -R \\$UID_GID test/browser/visual.spec.mjs-snapshots; exit \\$status\"",
    "api:update": "UPDATE_API_SNAPSHOT=1 node --test test/api-surface.test.mjs",
    "coverage": "npm run coverage:core && npm run coverage:models",
    "coverage:core": "node --test --experimental-test-coverage --test-coverage-include=src/core/*.js --test-coverage-lines=90 test/*.test.mjs examples/custom-widget/*.test.mjs",
    "coverage:models": "node --test --experimental-test-coverage --test-coverage-include=src/elements/*.js --test-coverage-exclude=src/elements/grid.js --test-coverage-exclude=src/elements/widget.js --test-coverage-exclude=src/elements/picker.js --test-coverage-exclude=src/elements/grid-controls.js --test-coverage-exclude=src/elements/persist.js --test-coverage-exclude=src/elements/registry.js --test-coverage-exclude=src/elements/ticker.js --test-coverage-exclude=src/elements/dev.js --test-coverage-exclude=src/elements/html.js --test-coverage-exclude=src/elements/layout-list.js --test-coverage-lines=80 test/*.test.mjs examples/custom-widget/*.test.mjs",
    "release": "npm test && npm run lint && npm run build:lib && npm run build:dev && npm run build:umd && npm run build:cdn && npm run pack:lib && npm run verify:package && npm run size"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/react": "19.3.0",
    "emberwick": "0.14.2",
    "esbuild": "0.21.5",
    "eslint": "10.13.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "typescript": "5.9.3",
    "vite": "^5.4.0",
    "vue": "3.5.44"
  }
}
