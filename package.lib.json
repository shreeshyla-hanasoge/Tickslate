{
  "name": "tickslate",
  "version": "0.1.0",
  "description": "Dashboard widgets for the web: a resizable grid, KPI tiles, charts and cards for any data, with a finance set built in.",
  "license": "MIT",
  "author": "Shreeshyla Hanasoge <shreeshyla.hanasoge@gmail.com>",
  "homepage": "https://github.com/shreeshyla-hanasoge/Tickslate#readme",
  "bugs": {
    "url": "https://github.com/shreeshyla-hanasoge/Tickslate/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shreeshyla-hanasoge/Tickslate.git"
  },
  "type": "module",
  "sideEffects": [
    "./elements.js",
    "./elements.dev.js",
    "*.css"
  ],
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "unpkg": "./umd/tickslate.umd.js",
  "jsdelivr": "./umd/tickslate.umd.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./elements": {
      "types": "./elements.d.ts",
      "development": "./elements.dev.js",
      "import": "./elements.js",
      "default": "./elements.js"
    },
    "./tokens.css": "./tokens.css",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "emberwick": ">=0.14.0"
  },
  "peerDependenciesMeta": {
    "emberwick": {
      "optional": true
    }
  },
  "keywords": [
    "dashboard",
    "finance",
    "trading",
    "widgets",
    "grid",
    "web-components",
    "custom-elements",
    "pnl",
    "portfolio",
    "equity-curve",
    "kpi",
    "metrics",
    "chart",
    "analytics"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
